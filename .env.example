# Google AI Studio API credentials are read from the sibling API/chat1.md and
# API/chat2.md files by default. Set MRA_API_DIR if the private folder differs.
# Never commit API credentials. The app reads Gemini keys only from the two
# dedicated API files or the MRA_API_*_KEY variables below.
# Rate-limit fallback order: API1 3.5 -> API2 3.5 -> API1 3.1 -> API2 3.1.
# Fallback happens only for HTTP 429 / RESOURCE_EXHAUSTED.
MRA_API_DIR=
# Optional environment-based credentials (take precedence over the matching file).
MRA_API_1_KEY=
MRA_API_2_KEY=
# Optional: move private database and photos to a different directory.
# APP_DATA_DIR=C:\Users\YourName\Documents\MatchingReplyData
